{
  "name": "shared-features-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npx tsx postbuild-seo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "sync:apps-config": "npx trapeze run apps-config.yaml --android-project android --ios-project ios/App -y",
    "mobile:sync": "yarn build && yarn cap:sync && yarn sync:apps-config"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.43.0",
    "@capacitor-firebase/analytics": "^8.3.0",
