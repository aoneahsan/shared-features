{
  "name": "shared-features",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.13.0"
  },
  "description": "Shared features for Zaions projects - centralized ads, notifications, broadcasts, contacts, and more",
  "author": "Ahsan Mahmood <aoneahsan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aoneahsan/shared-features"
  },
  "keywords": [
    "zaions",
    "shared-features",
    "ads",
    "campaigns",
    "notifications",
    "broadcasts",
    "in-app-notifications",
    "react",
    "firebase",
    "cross-promotion"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.cjs"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js",
      "require": "./dist/services/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "import": "./dist/notifications/index.js",
      "require": "./dist/notifications/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AI-INTEGRATION-GUIDE.md"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "@capacitor/preferences": ">=8.0.0",
    "@radix-ui/react-icons": ">=1.3.2",
    "@radix-ui/themes": ">=3.2.1",
    "firebase": ">=12.8.0",
    "lucide-react": ">=0.562.0",
    "react": ">=19.2.3",
    "react-dom": ">=19.2.3",
    "zustand": ">=5.0.10"
  },
  "peerDependenciesMeta": {
    "@capacitor/preferences": {
      "optional": true
    }
  },
  "devDependencies": {
    "@capacitor/preferences": "^8.0.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.1.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "firebase": "^12.8.0",
    "globals": "^17.3.0",
    "lucide-react": "^0.563.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "zustand": "^5.0.11"
  },
  "dependencies": {}
}
