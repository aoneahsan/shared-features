{
  "name": "shared-features",
  "version": "0.1.15",
  "engines": {
    "node": ">=24.13.0"
  },
  "description": "Feature flags, cross-promotion ads and in-app broadcasts for React apps, from one admin panel.",
  "author": "Ahsan Mahmood <aoneahsan@gmail.com> (https://aoneahsan.com)",
  "license": "MIT",
  "homepage": "https://shared-features-docs.aoneahsan.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoneahsan/shared-features.git"
  },
  "bugs": {
    "url": "https://github.com/aoneahsan/shared-features/issues"
  },
  "funding": "https://aoneahsan.com/payment?project-id=shared-features&project-identifier=shared-features",
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "in-app-notifications",
    "broadcasts",
    "announcements",
    "cross-promotion",
    "ads",
    "react",
    "firebase",
    "firestore"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.cjs"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js",
      "require": "./dist/services/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "import": "./dist/notifications/index.js",
      "require": "./dist/notifications/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "AI-INTEGRATION-GUIDE.md"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "@capacitor/preferences": ">=8.0.0",
    "@radix-ui/react-icons": ">=1.3.2",
    "@radix-ui/themes": ">=3.2.1",
    "firebase": ">=12.8.0",
    "lucide-react": ">=0.562.0",
    "react": ">=19.2.3",
    "react-dom": ">=19.2.3",
    "zustand": ">=5.0.10"
  },
  "peerDependenciesMeta": {
    "@capacitor/preferences": {
      "optional": true
    }
  },
  "devDependencies": {
    "@capacitor/preferences": "^8.0.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase": "^12.14.0",
    "globals": "^17.6.0",
    "lucide-react": "^1.17.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "zustand": "^5.0.14"
  }
}
