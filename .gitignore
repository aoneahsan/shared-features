# Dependencies
node_modules/

# Build output
dist/
build/
www/
.output/

# Caches / framework artifacts
.vite/
.next/
.docusaurus/
.wxt/
coverage/

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store

# Logs
*.log

# Environment / secrets — PRIVATE repo: .env / keystores ARE tracked, do NOT ignore them.

# Firebase hosting cache (per 2026-04-22: untracked across all projects)
.firebase/hosting.*

# Claude Code local state
.claude/

# Yarn 4 (Berry) — ignore cache/state, allow patches/plugins/releases/sdks/versions
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
# Nested sub-packages (e.g. website/) also generate .yarn cache/state
**/.yarn/install-state.gz
**/.yarn/cache
.pnp.*

# Custom rules (standard across all Ahsan projects)
*.ignore.*
project-record-ignore/
